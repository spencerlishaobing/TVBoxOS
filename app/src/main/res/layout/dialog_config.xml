<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical"
        android:padding="@dimen/vs_30">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="配置（扫码推送线路/多仓）"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_26" />

        <!-- 第一行：二维码 + 推送解析名称列表 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_20"
            android:orientation="horizontal">

            <!-- 左侧二维码 -->
            <LinearLayout
                android:layout_width="@dimen/vs_240"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivQRCode"
                    android:layout_width="@dimen/vs_220"
                    android:layout_height="@dimen/vs_220"
                    android:layout_gravity="center_horizontal"
                    android:focusable="false" />

                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_10"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.5"
                    android:textColor="@color/dialog_text_hint"
                    android:textSize="@dimen/ts_18"
                    tools:text="http://192.168.1.100:9978/push.html" />
            </LinearLayout>

            <!-- 右侧名称列表（多仓，可选中） -->
            <LinearLayout
                android:layout_width="@dimen/vs_440"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_20"
                android:layout_marginLeft="@dimen/vs_20"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="推送解析（多仓，选中后自动填入下方）"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_22" />

                <LinearLayout
                    android:id="@+id/llNames"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_10"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_10"
                    android:gravity="center"
                    android:text="暂无已保存的多仓，可在下方手动输入"
                    android:textColor="@color/dialog_text_hint"
                    android:textSize="@dimen/ts_20"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- 第二行：手动输入（名称 + 推送链接） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_20"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etName"
                android:layout_width="@dimen/vs_180"
                android:layout_height="wrap_content"
                android:background="@drawable/input_dialog_api_input"
                android:hint="名称"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:inputType="text"
                android:maxLines="1"
                android:paddingLeft="@dimen/vs_2"
                android:paddingTop="@dimen/vs_10"
                android:paddingRight="@dimen/vs_2"
                android:paddingBottom="@dimen/vs_10"
                android:singleLine="true"
                android:textColor="@color/dialog_text_primary"
                android:textColorHint="@color/dialog_text_hint"
                android:textSize="@dimen/ts_26" />

            <EditText
                android:id="@+id/etUrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_10"
                android:layout_marginLeft="@dimen/vs_10"
                android:layout_weight="1"
                android:background="@drawable/input_dialog_api_input"
                android:hint="推送链接（线路/多仓地址）"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingLeft="@dimen/vs_2"
                android:paddingTop="@dimen/vs_10"
                android:paddingRight="@dimen/vs_2"
                android:paddingBottom="@dimen/vs_10"
                android:singleLine="true"
                android:textColor="@color/dialog_text_primary"
                android:textColorHint="@color/dialog_text_hint"
                android:textSize="@dimen/ts_26" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSubmit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/vs_20"
            android:background="@drawable/button_danmu_setting"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="@dimen/vs_40"
            android:paddingTop="@dimen/vs_10"
            android:paddingRight="@dimen/vs_40"
            android:paddingBottom="@dimen/vs_10"
            android:text="确定"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_22" />
    </LinearLayout>
</FrameLayout>
