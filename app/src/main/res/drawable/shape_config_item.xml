<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <corners android:radius="8mm" />
            <stroke android:width="2mm" android:color="@color/dialog_control_stroke_focused" />
            <solid android:color="@color/dialog_control_bg_focused" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="8mm" />
            <stroke android:width="2mm" android:color="@color/dialog_control_stroke_focused" />
            <solid android:color="@color/dialog_control_bg_focused" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="8mm" />
            <stroke android:width="1mm" android:color="@color/color_6C3D3D3D" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
